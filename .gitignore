# Dependencies
node_modules/

# Build output (generated by npm run build / npm run dist)
client/dist/
server-dist/
dist-electron/

# Local runtime data (dev-mode fallback data dir; real installs use %APPDATA%)
.data/
*.db
*.db-shm
*.db-wal
*.db.bak

# Env / secrets
.env
google-oauth.json
.env.*

# Logs
*.log
npm-debug.log*

# Your private record of issued license keys — never commit school names/keys
licenses-issued.json

# OS/editor cruft
.DS_Store
Thumbs.db

# Standalone License Admin build output
license-admin-app/
dist-license-admin/

# White-label build temp files (scripts/package-brand.js)
electron/brand.json
electron/pzm-logo.png
electron-builder.*.tmp.json
